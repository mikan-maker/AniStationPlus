<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>AniStation+ | Official Cyber Streaming Portal</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Noto+Sans+JP:wght@400;500;700;900&family=JetBrains+Mono:wght@600;800&display=swap" rel="stylesheet">

  <!-- External CDNs -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>

  <style>
    /* ====================================================
       CSS変数・基本設定
       ==================================================== */
    :root {
      --bg-black: #06060c;
      --bg-card: rgba(13, 15, 28, 0.85);
      --bg-panel: #0a0b16;
      --neon-cyan: #00f0ff;
      --neon-blue: #0066ff;
      --neon-magenta: #ff00ff;
      --neon-pink: #ff007f;
      --neon-purple: #8b00ff;
      --neon-gold: #ffb800;
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
      --border-glow: rgba(0, 240, 255, 0.35);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --grad-cyan-pink: linear-gradient(135deg, var(--neon-cyan) 0%, var(--neon-purple) 50%, var(--neon-magenta) 100%);
      --glow-cyan-sm: 0 0 10px rgba(0, 240, 255, 0.5);
      --glow-cyan-lg: 0 0 25px rgba(0, 240, 255, 0.8), 0 0 50px rgba(0, 240, 255, 0.35);
      --glow-pink-sm: 0 0 10px rgba(255, 0, 255, 0.5);
      --glow-gold: 0 0 16px rgba(255, 184, 0, 0.65);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      background-color: var(--bg-black);
      color: var(--text-main);
      font-family: 'Noto Sans JP', sans-serif;
      overflow-x: hidden;
      min-height: 100vh;
      position: relative;
    }

    /* Three.js 3D固定背景 Canvas */
    #threeCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 1;
      pointer-events: none;
      display: block;
    }

    .cyber-grid-overlay {
      position: fixed;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background-size: 50px 50px;
      background-image: 
        linear-gradient(to right, rgba(0, 240, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 0, 255, 0.03) 1px, transparent 1px);
    }

    #flashBangOverlay {
      position: fixed;
      inset: 0;
      background: #ff0055;
      opacity: 0;
      pointer-events: none;
      z-index: 99999;
      transition: opacity 0.15s ease-out;
    }

    /* ====================================================
       画面1：会員登録LP（ランディングページ）
       ==================================================== */
    #lpContainer {
      position: relative;
      z-index: 10;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 1.5rem 5rem;
    }

    .lp-brand-emblem {
      width: 135px;
      height: 135px;
      border-radius: 34px;
      object-fit: cover;
      box-shadow: 0 0 35px rgba(0, 240, 255, 0.6), 0 0 75px rgba(255, 0, 255, 0.45);
      border: 2px solid rgba(255, 255, 255, 0.25);
      margin-bottom: 1.8rem;
    }

    .lp-badge-row {
      display: flex;
      gap: 0.8rem;
      margin-bottom: 1.5rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .badge-chip {
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.45rem 1.2rem;
      border-radius: 999px;
      letter-spacing: 0.06em;
      backdrop-filter: blur(10px);
    }

    .chip-cyan {
      background: rgba(0, 240, 255, 0.12);
      border: 1px solid var(--neon-cyan);
      color: var(--neon-cyan);
      box-shadow: var(--glow-cyan-sm);
    }

    .chip-magenta {
      background: rgba(255, 0, 255, 0.12);
      border: 1px solid var(--neon-magenta);
      color: #ff80ff;
      box-shadow: var(--glow-pink-sm);
    }

    .lp-hero-headline {
      font-size: clamp(2.1rem, 5vw, 3.8rem);
      font-weight: 900;
      text-align: center;
      line-height: 1.25;
      letter-spacing: -0.02em;
      max-width: 950px;
      margin-bottom: 1.2rem;
    }

    .lp-hero-headline .text-glow {
      background: linear-gradient(135deg, var(--neon-cyan) 10%, #e0aaff 60%, var(--neon-magenta) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 25px rgba(0, 240, 255, 0.45));
    }

    .lp-sub-headline {
      color: var(--text-sub);
      font-size: clamp(1rem, 2vw, 1.25rem);
      text-align: center;
      max-width: 680px;
      margin-bottom: 2.5rem;
      line-height: 1.65;
    }

    .lp-pricing-box {
      width: 100%;
      max-width: 530px;
      background: var(--bg-card);
      backdrop-filter: blur(25px);
      border-radius: 28px;
      border: 1px solid var(--border-glow);
      box-shadow: 0 0 60px rgba(0, 0, 0, 0.9), 0 0 35px rgba(0, 240, 255, 0.22);
      padding: 3rem 2.4rem;
      text-align: center;
      position: relative;
    }

    .price-sub-caption {
      font-family: 'Orbitron', sans-serif;
      font-size: 0.95rem;
      letter-spacing: 0.2em;
      color: var(--neon-cyan);
      margin-bottom: 0.6rem;
      font-weight: 800;
    }

    .price-num-wrap {
      display: flex;
      align-items: baseline;
      justify-content: center;
      gap: 0.4rem;
      margin-bottom: 0.4rem;
    }

    .price-currency {
      font-size: 2.2rem;
      font-weight: 900;
      color: #fff;
    }

    .price-digits {
      font-family: 'Orbitron', sans-serif;
      font-size: 5.2rem;
      font-weight: 900;
      line-height: 1;
      background: linear-gradient(180deg, #ffffff 40%, #c4b5fd 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      filter: drop-shadow(0 0 30px rgba(255, 255, 255, 0.35));
    }

    .price-period-label {
      font-size: 1.2rem;
      color: var(--text-sub);
      font-weight: 700;
    }

    .lp-feature-items {
      list-style: none;
      text-align: left;
      border-top: 1px dashed rgba(255, 255, 255, 0.12);
      border-bottom: 1px dashed rgba(255, 255, 255, 0.12);
      padding: 1.4rem 0.5rem;
      margin: 1.8rem 0 2.2rem;
    }

    .lp-feature-items li {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-size: 0.95rem;
      margin-bottom: 0.85rem;
      color: #e2e8f0;
    }

    .lp-feature-items li:last-child {
      margin-bottom: 0;
    }

    .icon-check-svg {
      color: var(--neon-cyan);
      width: 20px;
      height: 20px;
      flex-shrink: 0;
    }

    .btn-super-cyber {
      width: 100%;
      padding: 1.35rem 1.8rem;
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 1.2rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      color: #fff;
      border: none;
      border-radius: 16px;
      background: var(--grad-cyan-pink);
      box-shadow: 0 0 30px rgba(0, 240, 255, 0.55), 0 0 55px rgba(255, 0, 255, 0.45);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-super-cyber:hover {
      transform: translateY(-4px) scale(1.02);
      box-shadow: 0 0 45px rgba(0, 240, 255, 0.85), 0 0 80px rgba(255, 0, 255, 0.75);
    }

    .btn-super-cyber:active {
      transform: translateY(1px) scale(0.98);
    }

    /* ====================================================
       画面2：専用アニメポータル（2カラム・コックピットUI）
       ==================================================== */
    #portalContainer {
      display: none;
      position: relative;
      z-index: 20;
      min-height: 100vh;
      flex-direction: column;
      opacity: 0;
    }

    .cyber-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.9rem 2.2rem;
      background: rgba(8, 9, 18, 0.94);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(0, 240, 255, 0.2);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-logo-container {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      cursor: pointer;
    }

    .header-logo-container img {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      border: 1px solid rgba(0, 240, 255, 0.6);
      box-shadow: 0 0 12px rgba(0, 240, 255, 0.5);
    }

    .header-brand-title {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.45rem;
      font-weight: 900;
      color: #fff;
    }

    .header-brand-title span {
      color: var(--neon-magenta);
    }

    .pro-member-pill {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      background: rgba(255, 184, 0, 0.12);
      border: 1px solid var(--neon-gold);
      color: var(--neon-gold);
      padding: 0.45rem 1.25rem;
      border-radius: 999px;
      font-family: 'Orbitron', 'Noto Sans JP', sans-serif;
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      box-shadow: var(--glow-gold);
    }

    .gold-dot-blink {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--neon-gold);
      box-shadow: 0 0 10px var(--neon-gold);
      animation: blinkGold 1.8s infinite;
    }

    @keyframes blinkGold {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.3; transform: scale(0.8); }
    }

    /* 2カラムレイアウト構造 */
    .portal-main-layout {
      display: flex;
      flex: 1;
      height: calc(100vh - 72px);
      overflow: hidden;
    }

    /* 左側プロ仕様固定サイドバー */
    .cyber-sidebar {
      width: 250px;
      background: #070812;
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      padding: 1.8rem 0.9rem;
      gap: 0.65rem;
      flex-shrink: 0;
    }

    @media (max-width: 992px) {
      .portal-main-layout { flex-direction: column; height: auto; }
      .cyber-sidebar {
        width: 100%;
        flex-direction: row;
        justify-content: space-around;
        padding: 0.6rem 0.4rem;
        border-right: none;
        border-bottom: 1px solid var(--border-subtle);
        position: sticky;
        top: 72px;
        z-index: 90;
      }
    }

    .side-nav-btn {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.95rem 1.2rem;
      background: transparent;
      border: 1px solid transparent;
      border-radius: 12px;
      color: var(--text-sub);
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
      position: relative;
      text-align: left;
    }

    .side-nav-btn svg {
      width: 22px;
      height: 22px;
      flex-shrink: 0;
      transition: color 0.25s;
    }

    .side-nav-btn:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.04);
    }

    .side-nav-btn.active {
      color: var(--neon-cyan);
      background: rgba(0, 240, 255, 0.08);
      border-color: rgba(0, 240, 255, 0.4);
      box-shadow: inset 0 0 15px rgba(0, 240, 255, 0.15), 0 0 15px rgba(0, 240, 255, 0.2);
    }

    .side-nav-btn.active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 15%;
      height: 70%;
      width: 4px;
      background: var(--neon-cyan);
      border-radius: 0 4px 4px 0;
      box-shadow: 0 0 10px var(--neon-cyan);
    }

    .side-nav-btn.active svg {
      color: var(--neon-cyan);
      filter: drop-shadow(0 0 8px var(--neon-cyan));
    }

    /* 右側メインエリア */
    .portal-content-frame {
      flex: 1;
      overflow-y: auto;
      padding: 2.2rem 2.6rem 6rem;
      position: relative;
    }

    @media (max-width: 768px) {
      .portal-content-frame { padding: 1.2rem 1rem 4rem; }
    }

    .tab-view-container {
      display: none;
      opacity: 0;
      transform: translateY(14px);
      transition: opacity 0.35s ease, transform 0.35s ease;
    }

    .tab-view-container.show {
      display: block;
      opacity: 1;
      transform: translateY(0);
    }

    /* ====================================================
       タブ1：「ホーム」エリア（アマプラ超越アニメUI）
       ==================================================== */
    .hero-banner-cinema {
      position: relative;
      width: 100%;
      height: 440px;
      border-radius: 26px;
      overflow: hidden;
      margin-bottom: 3.5rem;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.95), 0 0 40px rgba(157, 0, 255, 0.3);
      display: flex;
      align-items: flex-end;
      padding: 3.2rem;
      background: 
        linear-gradient(to top, #04050a 10%, rgba(4, 5, 10, 0.5) 50%, transparent 90%),
        linear-gradient(135deg, rgba(157, 0, 255, 0.45) 0%, rgba(0, 240, 255, 0.3) 50%, rgba(255, 0, 255, 0.45) 100%),
        radial-gradient(circle at 75% 30%, #350963 0%, #060714 80%);
    }

    .hero-banner-info {
      position: relative;
      z-index: 2;
      max-width: 750px;
    }

    .hero-cinema-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(255, 0, 255, 0.2);
      border: 1px solid var(--neon-magenta);
      color: #ff80ff;
      padding: 0.38rem 0.95rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      margin-bottom: 1.1rem;
      box-shadow: var(--glow-pink-sm);
    }

    .hero-cinema-title {
      font-size: clamp(2.2rem, 4.5vw, 3.4rem);
      font-weight: 900;
      line-height: 1.18;
      margin-bottom: 0.85rem;
      color: #fff;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
    }

    .hero-cinema-desc {
      font-size: 1.05rem;
      color: #cbd5e1;
      line-height: 1.6;
      margin-bottom: 1.8rem;
    }

    .btn-hero-play {
      padding: 1.05rem 2.4rem;
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 1.15rem;
      font-weight: 900;
      color: #fff;
      background: var(--grad-cyan-pink);
      border: none;
      border-radius: 14px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.5), 0 0 45px rgba(255, 0, 255, 0.45);
      transition: all 0.3s ease;
    }

    .btn-hero-play:hover {
      transform: translateY(-3px) scale(1.03);
      box-shadow: 0 0 40px rgba(0, 240, 255, 0.8), 0 0 70px rgba(255, 0, 255, 0.7);
    }

    /* カルーセルセクション */
    .carousel-row-wrap {
      margin-bottom: 3.5rem;
    }

    .carousel-top-bar {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 1.2rem;
    }

    .carousel-heading-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #fff;
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .carousel-title-accent {
      width: 6px;
      height: 20px;
      background: var(--neon-cyan);
      border-radius: 3px;
      box-shadow: 0 0 8px var(--neon-cyan);
    }

    .carousel-see-all {
      font-size: 0.85rem;
      color: var(--neon-cyan);
      cursor: pointer;
      font-weight: 700;
      transition: opacity 0.2s;
    }

    .carousel-see-all:hover {
      opacity: 0.75;
    }

    .carousel-cards-track {
      display: flex;
      gap: 1.4rem;
      overflow-x: auto;
      padding-bottom: 1.2rem;
      scroll-behavior: smooth;
    }

    .carousel-cards-track::-webkit-scrollbar {
      display: none;
    }

    /* 作品カード */
    .anime-shelf-card {
      flex: 0 0 290px;
      background: var(--bg-card);
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--border-subtle);
      cursor: pointer;
      position: relative;
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s, box-shadow 0.3s;
    }

    .anime-shelf-card:hover {
      transform: scale(1.06) translateY(-6px);
      border-color: var(--neon-cyan);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.9), 0 0 25px rgba(0, 240, 255, 0.45);
      z-index: 10;
    }

    .anime-card-thumbnail-box {
      position: relative;
      width: 100%;
      height: 165px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .thumb-bg-saiki { background: linear-gradient(135deg, #1e1b4b 0%, #4338ca 50%, #090a14 100%); }
    .thumb-bg-oshi { background: linear-gradient(135deg, #831843 0%, #be185d 50%, #090a14 100%); }
    .thumb-bg-jujutsu { background: linear-gradient(135deg, #14532d 0%, #15803d 50%, #090a14 100%); }
    .thumb-bg-solo { background: linear-gradient(135deg, #3b0764 0%, #6b21a8 50%, #090a14 100%); }
    .thumb-bg-frieren { background: linear-gradient(135deg, #134e4a 0%, #0f766e 50%, #090a14 100%); }
    .thumb-bg-chainsaw { background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 50%, #090a14 100%); }

    .thumb-lettering-ghost {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.4rem;
      font-weight: 900;
      color: rgba(255, 255, 255, 0.22);
      letter-spacing: 0.1em;
    }

    .card-badge-1080p {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(0, 0, 0, 0.75);
      border: 1px solid var(--neon-cyan);
      color: var(--neon-cyan);
      font-family: 'Orbitron', sans-serif;
      font-size: 0.7rem;
      font-weight: 800;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      backdrop-filter: blur(5px);
    }

    .anime-card-detail-pane {
      padding: 1.1rem 1.2rem;
    }

    .card-rating-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.4rem;
      font-size: 0.75rem;
    }

    .card-stars {
      color: var(--neon-gold);
      font-weight: 800;
      display: flex;
      align-items: center;
      gap: 0.2rem;
    }

    .card-episodes-total {
      color: var(--text-sub);
    }

    .card-headline-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 0.35rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .card-snippet-synopsis {
      font-size: 0.8rem;
      color: var(--text-sub);
      line-height: 1.45;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* ====================================================
       タブ2：「配信スケジュール」エリア（近未来週間番組表）
       ==================================================== */
    .schedule-header-pane {
      margin-bottom: 2.2rem;
    }

    .schedule-hero-title {
      font-family: 'Orbitron', 'Noto Sans JP', sans-serif;
      font-size: 1.9rem;
      font-weight: 900;
      color: #fff;
      margin-bottom: 0.45rem;
    }

    .schedule-table-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.6rem;
    }

    .schedule-day-column {
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
    }

    .schedule-day-header {
      padding: 1rem 1.3rem;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .day-name-label {
      font-family: 'Orbitron', sans-serif;
      font-size: 1.15rem;
      font-weight: 900;
      color: var(--neon-cyan);
      letter-spacing: 0.08em;
    }

    .day-badge-indicator {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.72rem;
      color: #ff80ff;
      font-weight: 800;
    }

    .blinking-led-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--neon-magenta);
      box-shadow: 0 0 8px var(--neon-magenta);
