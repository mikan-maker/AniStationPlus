      font-size: 0.82rem;
      color: var(--neon-cyan);
      font-weight: 700;
      margin-bottom: 0.3rem;
      display: inline-block;
    }

    .sch-anime-name {
      font-size: 0.98rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 0.25rem;
    }

    .sch-anime-sub {
      font-size: 0.8rem;
      color: var(--text-sub);
    }

    /* ====================================================
       タブ3：「マイリスト」エリア（SortableJS ＆ Chart.js）
       ==================================================== */
    .mylist-sortable-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
      gap: 1.8rem;
      margin-bottom: 3.5rem;
    }

    .mylist-item-card {
      background: var(--bg-panel);
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--border-subtle);
      transition: all 0.3s ease;
      cursor: grab;
    }

    .mylist-item-card:active {
      cursor: grabbing;
    }

    .mylist-item-card:hover {
      border-color: var(--neon-cyan);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.8), 0 0 20px rgba(0, 240, 255, 0.35);
    }

    .mylist-thumb-cover {
      position: relative;
      width: 100%;
      height: 165px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mylist-card-content {
      padding: 1.2rem;
    }

    .mylist-title-text {
      font-size: 1.05rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 0.4rem;
    }

    .mylist-progress-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.8rem;
      color: var(--text-sub);
      margin-bottom: 0.5rem;
    }

    .netflix-track-bar {
      width: 100%;
      height: 5px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 999px;
      overflow: hidden;
    }

    .netflix-fill-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta));
      box-shadow: 0 0 8px var(--neon-cyan);
      border-radius: 999px;
    }

    .analytics-charts-deck {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }

    .chart-panel-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      padding: 1.8rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
    }

    .chart-panel-title {
      font-family: 'Orbitron', 'Noto Sans JP', sans-serif;
      font-size: 1.15rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .chart-panel-title-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--neon-cyan);
      box-shadow: 0 0 8px var(--neon-cyan);
    }

    /* ====================================================
       タブ4：「限定ファンチャット」エリア（JSリアルタイムチャット）
       ==================================================== */
    .chat-deck-container {
      max-width: 960px;
      margin: 0 auto;
      background: #080913;
      border: 1px solid rgba(0, 240, 255, 0.28);
      border-radius: 24px;
      box-shadow: 0 0 45px rgba(0, 0, 0, 0.9), 0 0 25px rgba(0, 240, 255, 0.18);
      height: calc(100vh - 160px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .chat-top-header {
      padding: 1.2rem 1.8rem;
      background: rgba(255, 255, 255, 0.02);
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .chat-channel-info {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .chat-channel-title {
      font-family: 'Orbitron', 'Noto Sans JP', sans-serif;
      font-size: 1.15rem;
      font-weight: 900;
      color: #fff;
    }

    .chat-live-counter {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.78rem;
      color: var(--neon-cyan);
      font-family: 'JetBrains Mono', monospace;
    }

    .chat-stream-timeline {
      flex: 1;
      overflow-y: auto;
      padding: 1.6rem;
      display: flex;
      flex-direction: column;
      gap: 1.15rem;
    }

    .chat-stream-timeline::-webkit-scrollbar {
      width: 6px;
    }

    .chat-stream-timeline::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 4px;
    }

    .chat-speech-bubble-row {
      display: flex;
      gap: 0.95rem;
      animation: bubbleSlideIn 0.25s ease-out;
    }

    @keyframes bubbleSlideIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .chat-avatar-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      background: #14172a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Orbitron', sans-serif;
      font-weight: 800;
      font-size: 0.9rem;
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .avatar-pro-user {
      background: rgba(255, 184, 0, 0.15);
      border-color: var(--neon-gold);
      color: var(--neon-gold);
      box-shadow: 0 0 12px rgba(255, 184, 0, 0.35);
    }

    .avatar-user-cyan { color: var(--neon-cyan); border-color: rgba(0, 240, 255, 0.4); }
    .avatar-user-pink { color: var(--neon-magenta); border-color: rgba(255, 0, 255, 0.4); }
    .avatar-user-purple { color: #c084fc; border-color: rgba(192, 132, 252, 0.4); }

    .chat-message-bundle {
      display: flex;
      flex-direction: column;
      max-width: 82%;
    }

    .chat-user-header {
      display: flex;
      align-items: baseline;
      gap: 0.65rem;
      margin-bottom: 0.3rem;
    }

    .chat-author-name {
      font-size: 0.85rem;
      font-weight: 800;
      color: #fff;
    }

    .author-gold-badge {
      color: var(--neon-gold);
      text-shadow: 0 0 8px rgba(255, 184, 0, 0.5);
    }

    .chat-post-time {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.72rem;
      color: #64748b;
    }

    .chat-message-text {
      padding: 0.8rem 1.15rem;
      border-radius: 14px;
      font-size: 0.93rem;
      line-height: 1.55;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      color: #f1f5f9;
      word-break: break-word;
    }

    .text-gold-highlight {
      background: rgba(255, 184, 0, 0.08);
      border-color: rgba(255, 184, 0, 0.35);
      color: #fff;
    }

    .chat-bottom-input-bar {
      padding: 1.2rem 1.6rem;
      background: rgba(255, 255, 255, 0.02);
      border-top: 1px solid var(--border-subtle);
      display: flex;
      gap: 0.85rem;
    }

    .chat-text-input {
      flex: 1;
      background: #04050a;
      border: 1px solid rgba(0, 240, 255, 0.3);
      border-radius: 12px;
      padding: 0.9rem 1.25rem;
      color: #fff;
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.25s, box-shadow 0.25s;
    }

    .chat-text-input:focus {
      border-color: var(--neon-cyan);
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
    }

    .btn-send-message {
      padding: 0 1.8rem;
      background: var(--grad-cyan-pink);
      border: none;
      border-radius: 12px;
      color: #fff;
      font-family: 'Orbitron', 'Noto Sans JP', sans-serif;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 0.06em;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.45rem;
      box-shadow: 0 0 18px rgba(0, 240, 255, 0.4);
      transition: all 0.25s;
    }

    .btn-send-message:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 28px rgba(0, 240, 255, 0.7);
    }

    /* ====================================================
       タブ5：専用動画プレイヤー画面 ＆ File API
       ==================================================== */
    .player-cockpit-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .video-viewport-box {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
      border-radius: 22px;
      overflow: hidden;
      border: 1px solid rgba(0, 240, 255, 0.45);
      box-shadow: 0 0 55px rgba(0, 240, 255, 0.25), 0 25px 65px rgba(0, 0, 0, 0.95);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* 実動画エレメント */
    #realVideoPlayer {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000;
      display: none;
      z-index: 2;
    }

    /* シミュレーション用Canvas */
    #streamSimulationCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
    }

    #dynamicWatermark {
      position: absolute;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.22);
      letter-spacing: 0.08em;
      pointer-events: none;
      z-index: 12;
      user-select: none;
      transition: top 3s ease, left 3s ease;
      white-space: nowrap;
    }

    .corner-branding-tag {
      position: absolute;
      top: 1.6rem;
      right: 1.6rem;
      display: flex;
      align-items: center;
      gap: 0.55rem;
      opacity: 0.7;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.88rem;
      font-weight: 800;
      pointer-events: none;
      color: #fff;
      z-index: 10;
    }

    .center-action-play {
      position: absolute;
      width: 84px;
      height: 84px;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.65);
      border: 2px solid var(--neon-cyan);
      box-shadow: 0 0 35px var(--neon-cyan);
      display: none;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: #fff;
      transition: all 0.25s ease;
      z-index: 15;
    }

    .center-action-play:hover {
      transform: scale(1.1);
      background: rgba(0, 240, 255, 0.3);
    }

    .player-hud-cockpit {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1.6rem 1.8rem 1.1rem;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.95) 0%, rgba(0, 0, 0, 0.65) 60%, transparent 100%);
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      z-index: 20;
    }

    .hud-seek-bar-track {
      position: relative;
      width: 100%;
      height: 7px;
      background: rgba(255, 255, 255, 0.22);
      border-radius: 999px;
      cursor: pointer;
      transition: height 0.15s ease;
    }

    .hud-seek-bar-track:hover {
      height: 10px;
    }

    .hud-seek-progress-fill {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--neon-cyan), var(--neon-magenta));
      border-radius: 999px;
      box-shadow: 0 0 12px var(--neon-cyan);
    }

    .hud-controls-deck {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .hud-left-items, .hud-right-items {
      display: flex;
      align-items: center;
      gap: 1.25rem;
    }

    .hud-ctrl-btn {
      background: none;
      border: none;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .hud-ctrl-btn:hover {
      color: var(--neon-cyan);
      transform: scale(1.15);
    }

    .hud-playback-timer {
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.92rem;
      color: #cbd5e1;
      letter-spacing: 0.05em;
    }

    .hud-volume-control-box {
      display: flex;
      align-items: center;
      gap: 0.65rem;
    }

    .hud-slider-range {
      -webkit-appearance: none;
      width: 80px;
      height: 4px;
      background: rgba(255, 255, 255, 0.28);
      border-radius: 999px;
      outline: none;
      cursor: pointer;
    }

    .hud-slider-range::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--neon-cyan);
      box-shadow: 0 0 8px var(--neon-cyan);
    }

    .quality-popover-anchor {
      position: relative;
    }

    .quality-badge-btn {
      background: rgba(0, 240, 255, 0.15);
      border: 1px solid var(--neon-cyan);
      color: var(--neon-cyan);
      font-family: 'Orbitron', sans-serif;
      font-size: 0.78rem;
      font-weight: 800;
      padding: 0.35rem 0.8rem;
      border-radius: 6px;
      cursor: pointer;
      box-shadow: 0 0 10px rgba(0, 240, 255, 0.35);
    }

    .quality-dropdown-flyout {
      position: absolute;
      bottom: 145%;
      right: 0;
      background: #080913;
      border: 1px solid var(--neon-cyan);
      border-radius: 8px;
      box-shadow: 0 0 18px rgba(0, 240, 255, 0.45);
      display: none;
      flex-direction: column;
      overflow: hidden;
      z-index: 50;
      min-width: 110px;
    }

    .quality-item-btn {
      padding: 0.55rem 0.9rem;
      font-family: 'Orbitron', sans-serif;
      font-size: 0.78rem;
      color: #fff;
      cursor: pointer;
      transition: background 0.2s;
    }

    .quality-item-btn:hover {
      background: rgba(0, 240, 255, 0.2);
      color: var(--neon-cyan);
    }

    /* デモ専用File APIアップロードツールバー */
    .file-upload-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(0, 240, 255, 0.06);
      border: 1px dashed var(--neon-cyan);
      border-radius: 14px;
      padding: 0.9rem 1.4rem;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .file-upload-label-btn {
      background: var(--grad-cyan-pink);
      color: #fff;
      padding: 0.6rem 1.4rem;
      border-radius: 10px;
      font-family: 'Noto Sans JP', sans-serif;
      font-size: 0.88rem;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .file-upload-label-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 0 25px rgba(0, 240, 255, 0.7);
    }

    .file-status-text {
      font-size: 0.85rem;
      color: var(--neon-cyan);
      font-family: 'JetBrains Mono', monospace;
    }

    .player-meta-description-deck {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1.6rem;
      background: var(--bg-panel);
      border: 1px solid var(--border-subtle);
      border-radius: 20px;
      padding: 1.6rem 1.9rem;
    }

    .video-active-title {
      font-size: 1.45rem;
      font-weight: 900;
      color: #fff;
      margin-bottom: 0.45rem;
    }

    .video-active-synopsis {
      font-size: 0.92rem;
      color: var(--text-sub);
      line-height: 1.65;
    }
  </style>
</head>
