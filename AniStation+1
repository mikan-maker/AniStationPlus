  <script>
    /* ====================================================
       1. Three.js 3Dパーティクル・サイバースペース
       ==================================================== */
    const threeCanvas = document.getElementById('threeCanvas');
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 1, 3000);
    camera.position.z = 1000;

    const renderer = new THREE.WebGLRenderer({ canvas: threeCanvas, alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    const particleCount = 3500;
    const particleGeometry = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    const colors = new Float32Array(particleCount * 3);

    const cyanColor = new THREE.Color(0x00f0ff);
    const magentaColor = new THREE.Color(0xff00ff);

    for (let i = 0; i < particleCount; i++) {
      positions[i * 3] = (Math.random() - 0.5) * 2000;
      positions[i * 3 + 1] = (Math.random() - 0.5) * 2000;
      positions[i * 3 + 2] = (Math.random() - 0.5) * 3000;

      const chosenColor = Math.random() > 0.5 ? cyanColor : magentaColor;
      colors[i * 3] = chosenColor.r;
      colors[i * 3 + 1] = chosenColor.g;
      colors[i * 3 + 2] = chosenColor.b;
    }

    particleGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    particleGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const particleMaterial = new THREE.PointsMaterial({
      size: 2.8,
      vertexColors: true,
      transparent: true,
      opacity: 0.85,
      blending: THREE.AdditiveBlending
    });

    const particleSystem = new THREE.Points(particleGeometry, particleMaterial);
    scene.add(particleSystem);

    let targetMouseX = 0;
    let targetMouseY = 0;
    let currentMouseX = 0;
    let currentMouseY = 0;

    function onPointerMove(x, y) {
      targetMouseX = (x - window.innerWidth / 2) * 0.35;
      targetMouseY = (y - window.innerHeight / 2) * 0.35;
    }

    window.addEventListener('mousemove', (e) => onPointerMove(e.clientX, e.clientY));
    window.addEventListener('touchmove', (e) => {
      if (e.touches.length > 0) {
        onPointerMove(e.touches[0].clientX, e.touches[0].clientY);
      }
    }, { passive: true });

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    function renderThreeLoop() {
      requestAnimationFrame(renderThreeLoop);

      const posArr = particleGeometry.attributes.position.array;
      for (let i = 0; i < particleCount; i++) {
        posArr[i * 3 + 2] += 4.5;
        if (posArr[i * 3 + 2] > 1000) {
          posArr[i * 3 + 2] = -2000;
          posArr[i * 3] = (Math.random() - 0.5) * 2000;
          posArr[i * 3 + 1] = (Math.random() - 0.5) * 2000;
        }
      }
      particleGeometry.attributes.position.needsUpdate = true;

      currentMouseX += (targetMouseX - currentMouseX) * 0.05;
      currentMouseY += (targetMouseY - currentMouseY) * 0.05;

      camera.position.x = currentMouseX;
      camera.position.y = -currentMouseY;
      camera.lookAt(0, 0, 0);

      renderer.render(scene, camera);
    }
    renderThreeLoop();

    /* ====================================================
       2. Anime.js モーフィング遷移（LP → ポータル）
       ==================================================== */
    const btnRegisterTrigger = document.getElementById('btnRegisterTrigger');
    const lpContainer = document.getElementById('lpContainer');
    const portalContainer = document.getElementById('portalContainer');

    btnRegisterTrigger.addEventListener('click', () => {
      const timeline = anime.timeline({
        easing: 'cubicBezier(0.16, 1, 0.3, 1)'
      });

      timeline
        .add({
          targets: '.anim-target',
          scale: [1, 1.15, 0],
          opacity: [1, 0],
          translateY: () => anime.random(-150, 150),
          translateX: () => anime.random(-200, 200),
          rotate: () => anime.random(-30, 30),
          delay: anime.stagger(60),
          duration: 700
        })
        .add({
          targets: lpContainer,
          opacity: [1, 0],
          duration: 300,
          complete: () => {
            lpContainer.style.display = 'none';
            portalContainer.style.display = 'flex';

            Swal.fire({
              title: '[AniStation+] プレミアム認証完了',
              text: '永久プロメンバーとしてログインしました。全編見放題をお楽しみください。',
              icon: 'success',
              background: '#090a16',
              color: '#f8fafc',
              confirmButtonColor: '#00f0ff',
              confirmButtonText: 'ストリーミング開始',
              backdrop: 'rgba(0, 240, 255, 0.15)'
            });

            initMylistFeatures();
          }
        })
        .add({
          targets: portalContainer,
          opacity: [0, 1],
          duration: 600
        })
        .add({
          targets: '.cyber-sidebar, .cyber-header',
          translateX: [-60, 0],
          opacity: [0, 1],
          duration: 700,
          easing: 'easeOutElastic(1, .8)'
        }, '-=400')
        .add({
          targets: '#tab-home > *',
          translateY: [40, 0],
          opacity: [0, 1],
          delay: anime.stagger(100),
          duration: 800,
          easing: 'easeOutCubic'
        }, '-=500');
    });

    /* ====================================================
       3. サイドバー動的タブ切り替え
       ==================================================== */
    const navButtons = document.querySelectorAll('.side-nav-btn');
    const tabViews = document.querySelectorAll('.tab-view-container');

    function switchNavTab(tabId) {
      navButtons.forEach(btn => {
        if (btn.dataset.tab === tabId) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });

      tabViews.forEach(view => {
        view.classList.remove('show');
      });

      const activeView = document.getElementById('tab-' + tabId);
      if (activeView) {
        setTimeout(() => {
          activeView.classList.add('show');
        }, 50);
      }

      if (tabId === 'player') {
        resizeStreamCanvas();
      }
    }

    /* ====================================================
       4. 作品カードクリック ＆ プレイヤー連動
       ==================================================== */
    const playerSeriesBadge = document.getElementById('playerSeriesBadge');
    const playerTitleLabel = document.getElementById('playerTitleLabel');
    const playerSynopsisLabel = document.getElementById('playerSynopsisLabel');

    function openPlayerWithDetails(series, title, synopsis) {
      playerSeriesBadge.innerText = series;
      playerTitleLabel.innerText = title;
      playerSynopsisLabel.innerText = synopsis;

      if (hasRealVideo) {
        realVideoPlayer.currentTime = 0;
        realVideoPlayer.play();
      } else {
        simulationPlaybackSec = 0;
      }
      setPlaybackActive(true);
      switchNavTab('player');
    }

    /* ====================================================
       5. マイリスト（SortableJS ＆ Chart.js）
       ==================================================== */
    let chartInstanceBar = null;
    let chartInstanceRadar = null;

    function initMylistFeatures() {
      const sortableEl = document.getElementById('sortableMylistGrid');
      Sortable.create(sortableEl, {
        animation: 250,
        ghostClass: 'sortable-ghost'
      });

      if (!chartInstanceBar) {
        const ctxBar = document.getElementById('weeklyWatchChart').getContext('2d');
        chartInstanceBar = new Chart(ctxBar, {
          type: 'bar',
          data: {
            labels: ['月', '火', '水', '木', '金', '土', '日'],
            datasets: [{
              label: '視聴時間 (h)',
              data: [3.5, 2.0, 5.2, 1.8, 6.4, 8.5, 7.2],
              backgroundColor: 'rgba(0, 240, 255, 0.45)',
              borderColor: '#00f0ff',
              borderWidth: 2,
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            scales: {
              x: { grid: { color: 'rgba(255,255,255,0.06)' }, ticks: { color: '#94a3b8' } },
              y: { grid: { color: 'rgba(255,255,255,0.06)' }, ticks: { color: '#94a3b8' } }
            },
            plugins: {
              legend: { labels: { color: '#fff', font: { family: 'Orbitron' } } }
            }
          }
        });
      }

      if (!chartInstanceRadar) {
        const ctxRadar = document.getElementById('genreRadarChart').getContext('2d');
        chartInstanceRadar = new Chart(ctxRadar, {
          type: 'radar',
          data: {
            labels: ['ギャグ/日常', 'ダークサスペンス', '異世界/ファンタジー', 'バトルアクション', '恋愛/ドラマ'],
            datasets: [{
              label: '視聴嗜好指数',
              data: [95, 88, 70, 92, 60],
              backgroundColor: 'rgba(255, 0, 255, 0.3)',
              borderColor: '#ff00ff',
              pointBackgroundColor: '#00f0ff',
              borderWidth: 2
            }]
          },
          options: {
            responsive: true,
            scales: {
              r: {
                angleLines: { color: 'rgba(255,255,255,0.1)' },
                grid: { color: 'rgba(255,255,255,0.1)' },
                pointLabels: { color: '#cbd5e1', font: { size: 11, family: 'Noto Sans JP' } },
                ticks: { display: false }
              }
            },
            plugins: {
              legend: { labels: { color: '#fff', font: { family: 'Orbitron' } } }
            }
          }
        });
      }
    }

    /* ====================================================
       6. リアルタイムチャット
       ==================================================== */
    const chatStreamBox = document.getElementById('chatStreamBox');
    const chatMessageField = document.getElementById('chatMessageField');

    function handleSendChatMessage(e) {
      e.preventDefault();
      const content = chatMessageField.value.trim();
      if (!content) return;

      const date = new Date();
      const h = date.getHours().toString().padStart(2, '0');
      const m = date.getMinutes().toString().padStart(2, '0');

      const bubbleRow = document.createElement('div');
      bubbleRow.className = 'chat-speech-bubble-row';
      bubbleRow.innerHTML = `
        <div class="chat-avatar-icon avatar-pro-user">PRO</div>
        <div class="chat-message-bundle">
          <div class="chat-user-header">
            <span class="chat-author-name author-gold-badge">PRO_MEMBER</span>
            <span class="chat-post-time">${h}:${m}</span>
          </div>
          <div class="chat-message-text text-gold-highlight">${escapeHTML(content)}</div>
        </div>
      `;

      chatStreamBox.appendChild(bubbleRow);
      chatMessageField.value = '';

      chatStreamBox.scrollTo({
        top: chatStreamBox.scrollHeight,
        behavior: 'smooth'
      });
    }

    function escapeHTML(str) {
      return str.replace(/[&<>'"]/g, 
        tag => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[tag] || tag)
      );
    }

    /* ====================================================
       7. 専用動画プレイヤー ＆ File APIローカル動画再生
       ==================================================== */
    let isStreamActive = true;
    let hasRealVideo = false;
    let simulationPlaybackSec = 45;
    let totalPlaybackDuration = 1455; // 24:15

    const realVideoPlayer = document.getElementById('realVideoPlayer');
    const streamCanvas = document.getElementById('streamSimulationCanvas');
    const streamCtx = streamCanvas.getContext('2d');
    const videoSourceStatusText = document.getElementById('videoSourceStatusText');
    const videoSeekFill = document.getElementById('videoSeekFill');
    const currentTimeLabel = document.getElementById('currentTimeLabel');
    const totalDurationLabel = document.getElementById('totalDurationLabel');
    const hudPlaySvgIcon = document.getElementById('hudPlaySvgIcon');
    const centerActionPlayBtn = document.getElementById('centerActionPlayBtn');
    const mainVideoPlayerBox = document.getElementById('mainVideoPlayerBox');
    const qualityDropdownFlyout = document.getElementById('qualityDropdownFlyout');
    const qualitySelectorLabel = document.getElementById('qualitySelectorLabel');
    const hudVolumeSlider = document.getElementById('hudVolumeSlider');

    function formatTimeCode(sec) {
      if (isNaN(sec)) sec = 0;
      const min = Math.floor(sec / 60).toString().padStart(2, '0');
      const s = Math.floor(sec % 60).toString().padStart(2, '0');
      return `${min}:${s}`;
    }

    function updateHudSeekDisplay(currSec, durSec) {
      const pct = durSec > 0 ? (currSec / durSec) * 100 : 0;
      videoSeekFill.style.width = pct + '%';
      currentTimeLabel.innerText = formatTimeCode(currSec);
      totalDurationLabel.innerText = formatTimeCode(durSec);
    }

    function setPlaybackActive(active) {
      isStreamActive = active;
      if (isStreamActive) {
        hudPlaySvgIcon.innerHTML = '<path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>';
        centerActionPlayBtn.style.display = 'none';
        if (hasRealVideo) realVideoPlayer.play();
      } else {
        hudPlaySvgIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
        centerActionPlayBtn.style.display = 'flex';
        if (hasRealVideo) realVideoPlayer.pause();
      }
    }

    function togglePlaybackState() {
      setPlaybackActive(!isStreamActive);
    }

    /* File API: ローカル動画の即時マウント */
    function handleLocalVideoFileSelect(e) {
      const file = e.target.files[0];
      if (!file) return;

      const videoObjectUrl = URL.createObjectURL(file);
      realVideoPlayer.src = videoObjectUrl;
      realVideoPlayer.style.display = 'block';
      streamCanvas.style.display = 'none';
      hasRealVideo = true;

      videoSourceStatusText.innerText = `> FILE LOADED: ${file.name.toUpperCase()} (1080p BITRATE DIRECT)`;
      playerSeriesBadge.innerText = 'LOCAL FILE DIRECT STREAM';
      playerTitleLabel.innerText = file.name;
      playerSynopsisLabel.innerText = `ローカルデバイスから読み込まれたデモ動画ファイル。File API (URL.createObjectURL) を介して専用サイバーコントローラーと完全同期中。サイズ: ${(file.size / (1024 * 1024)).toFixed(2)} MB`;

      realVideoPlayer.volume = hudVolumeSlider.value / 100;
      realVideoPlayer.play();
      setPlaybackActive(true);

      Swal.fire({
        title: '動画ファイルの読み込み完了',
        text: `「${file.name}」を正常にマウントしました。プレイヤーでコントロール可能です。`,
        icon: 'success',
        background: '#0a0a14',
        color: '#fff',
        confirmButtonColor: '#00f0ff'
      });
    }

    /* 実動画イベントリスナー */
    realVideoPlayer.addEventListener('timeupdate', () => {
      if (hasRealVideo && !realVideoPlayer.paused) {
        totalPlaybackDuration = realVideoPlayer.duration || totalPlaybackDuration;
        updateHudSeekDisplay(realVideoPlayer.currentTime, totalPlaybackDuration);
      }
    });

    realVideoPlayer.addEventListener('ended', () => {
      setPlaybackActive(false);
    });

    /* シークバークリック */
    function handleSeekTrackClick(e) {
      const track = document.getElementById('videoSeekTrack');
      const rect = track.getBoundingClientRect();
      const clickRatio = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));

      if (hasRealVideo) {
        const targetSec = clickRatio * (realVideoPlayer.duration || totalPlaybackDuration);
        realVideoPlayer.currentTime = targetSec;
        updateHudSeekDisplay(targetSec, realVideoPlayer.duration || totalPlaybackDuration);
      } else {
        simulationPlaybackSec = Math.floor(clickRatio * totalPlaybackDuration);
        updateHudSeekDisplay(simulationPlaybackSec, totalPlaybackDuration);
      }
    }

    /* 音量スライダー連動 */
    function handleVolumeSliderChange(val) {
      const vol = val / 100;
      if (hasRealVideo) {
        realVideoPlayer.volume = vol;
      }
    }

    function toggleMuteState() {
      if (hudVolumeSlider.value > 0) {
        hudVolumeSlider.value = 0;
        if (hasRealVideo) realVideoPlayer.volume = 0;
      } else {
        hudVolumeSlider.value = 85;
        if (hasRealVideo) realVideoPlayer.volume = 0.85;
      }
    }

    function toggleQualityDropdown() {
      qualityDropdownFlyout.style.display = qualityDropdownFlyout.style.display === 'flex' ? 'none' : 'flex';
    }

    function selectStreamQuality(label) {
      qualitySelectorLabel.innerText = label;
      qualityDropdownFlyout.style.display = 'none';
    }

    function togglePlayerFullscreen() {
      if (!document.fullscreenElement) {
        mainVideoPlayerBox.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    /* シミュレーションモード用タイマー（実動画未選択時に動作） */
    setInterval(() => {
      if (!hasRealVideo && isStreamActive) {
        simulationPlaybackSec++;
        if (simulationPlaybackSec >= totalPlaybackDuration) {
          simulationPlaybackSec = 0;
        }
        updateHudSeekDisplay(simulationPlaybackSec, totalPlaybackDuration);
      }
    }, 1000);

    /* ====================================================
       8. 動画スクリーン内 Canvas 波形アニメーション
       ==================================================== */
    function resizeStreamCanvas() {
      streamCanvas.width = mainVideoPlayerBox.clientWidth;
      streamCanvas.height = mainVideoPlayerBox.clientHeight;
    }

    window.addEventListener('resize', () => {
      if (portalContainer.style.display === 'flex') {
        resizeStreamCanvas();
      }
    });

    let waveFrameTick = 0;
    function renderStreamScene() {
      if (!hasRealVideo) {
        const w = streamCanvas.width;
        const h = streamCanvas.height;

        streamCtx.fillStyle = '#05060e';
        streamCtx.fillRect(0, 0, w, h);

        const horizonY = h * 0.72;
        streamCtx.strokeStyle = 'rgba(0, 240, 255, 0.12)';
        streamCtx.lineWidth = 1;
        for (let x = 0; x <= w; x += 40) {
          streamCtx.beginPath();
          streamCtx.moveTo(x, horizonY);
          streamCtx.lineTo((x - w / 2) * 3 + w / 2, h);
          streamCtx.stroke();
        }

        if (isStreamActive) waveFrameTick += 0.05;

        const barCount = 42;
        const barW = w / barCount;
        for (let i = 0; i < barCount; i++) {
          const amp = isStreamActive
            ? Math.sin(waveFrameTick + i * 0.35) * Math.cos(waveFrameTick * 0.7 + i) * 38 + 42
            : 5;
          const bx = i * barW;
          const by = horizonY - amp;

          const grad = streamCtx.createLinearGradient(0, by, 0, horizonY);
          grad.addColorStop(0, '#ff00ff');
          grad.addColorStop(0.6, '#00f0ff');
          grad.addColorStop(1, 'transparent');

          streamCtx.fillStyle = grad;
          streamCtx.fillRect(bx + 2, by, barW - 4, amp);
        }

        const orbGrad = streamCtx.createRadialGradient(w / 2, h / 2 - 20, 10, w / 2, h / 2 - 20, 120);
        orbGrad.addColorStop(0, 'rgba(0, 240, 255, 0.85)');
        orbGrad.addColorStop(0.5, 'rgba(255, 0, 255, 0.4)');
        orbGrad.addColorStop(1, 'transparent');
        streamCtx.fillStyle = orbGrad;
        streamCtx.beginPath();
        streamCtx.arc(w / 2, h / 2 - 20, 120, 0, Math.PI * 2);
        streamCtx.fill();

        streamCtx.fillStyle = '#ffffff';
        streamCtx.font = "bold 18px 'Orbitron', sans-serif";
        streamCtx.textAlign = 'center';
        streamCtx.fillText("AniStation+ OFFICIAL PRO STREAM", w / 2, h / 2 - 20);

        streamCtx.fillStyle = '#00f0ff';
        streamCtx.font = "bold 15px 'Noto Sans JP', sans-serif";
        streamCtx.fillText(playerTitleLabel.innerText, w / 2, h / 2 + 12);

        if (!isStreamActive) {
          streamCtx.fillStyle = 'rgba(0, 0, 0, 0.65)';
          streamCtx.fillRect(0, 0, w, h);
        }
      }

      requestAnimationFrame(renderStreamScene);
    }
    resizeStreamCanvas();
    renderStreamScene();

    /* ====================================================
       9. 動的ウォーターマーク（電子透かし）ランダム移動
       ==================================================== */
    const dynamicWatermark = document.getElementById('dynamicWatermark');
    function moveWatermark() {
      if (mainVideoPlayerBox.clientWidth > 0 && mainVideoPlayerBox.clientHeight > 0) {
        const maxX = mainVideoPlayerBox.clientWidth - 280;
        const maxY = mainVideoPlayerBox.clientHeight - 80;
        const randomX = Math.max(20, Math.random() * maxX);
        const randomY = Math.max(30, Math.random() * maxY);
        dynamicWatermark.style.left = randomX + 'px';
        dynamicWatermark.style.top = randomY + 'px';
      }
    }
    setInterval(moveWatermark, 4000);
    moveWatermark();

    /* ====================================================
       10. SweetAlert2 泥棒撃退フェイク警告（1DM/DevTools検知）
       ==================================================== */
    const flashBangOverlay = document.getElementById('flashBangOverlay');

    function triggerSecurityIntervention() {
      flashBangOverlay.style.opacity = '0.85';
      setTimeout(() => {
        flashBangOverlay.style.opacity = '0';
      }, 150);

      Swal.fire({
        title: '【警告】不正なパケット抽出アクティビティを検出',
        html: `
          <div style="text-align:left; font-size:0.88rem; line-height:1.6; color:#cbd5e1;">
            <p style="color:#ff3366; font-weight:800; margin-bottom:0.5rem;">[WIDEVINE L3 TAMPER DETECTED]</p>
            1DM / デベロッパーツールに類似するメディアストリーム傍受シグナルを検知しました。<br>
            AniStation+ の公式著作権保護システムに基づき、ストリーミングを一時遮断・暗号化保護します。<br>
            <span style="font-family:'JetBrains Mono'; font-size:0.75rem; color:#64748b;">TIMESTAMP: ${new Date().toISOString()}</span>
          </div>
        `,
        icon: 'error',
        background: '#0a0a14',
        color: '#ffffff',
        confirmButtonColor: '#ff0055',
        confirmButtonText: 'セッションを再検証して復帰',
        backdrop: 'rgba(255, 0, 85, 0.25)'
      });
    }

    window.addEventListener('keydown', (e) => {
      if (
        e.key === 'F12' || 
        (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'J' || e.key === 'C')) ||
        (e.metaKey && e.altKey && (e.key === 'I' || e.key === 'J' || e.key === 'C'))
      ) {
        e.preventDefault();
        triggerSecurityIntervention();
      }
    });

    window.addEventListener('contextmenu', (e) => {
      e.preventDefault();
      triggerSecurityIntervention();
    });
  </script>
</body>
</html>
